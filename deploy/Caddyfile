# Caddy na frente do web e da API: HTTPS automático (Let's Encrypt), HTTP/2-3, HSTS.
# Requer DNS do domínio apontando para o servidor e portas 80/443 abertas.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-X-Powered-By
	}

	request_body {
		max_size 2MB
	}

	# API (mesma origem do web: o cookie de sessão é do app)
	handle_path /api/v1/* {
		rewrite * /v1{path}
		reverse_proxy api:3200
	}

	# Service worker nunca em cache
	handle /sw.js {
		header Cache-Control "no-cache, no-store, must-revalidate"
		reverse_proxy web:3201
	}

	handle /_next/static/* {
		header Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy web:3201
	}

	handle {
		reverse_proxy web:3201
	}

	log {
		output stdout
		format json
	}
}
