# Copie para .env.prod e preencha. Nunca versione o .env.prod.
POSTGRES_USER=skedulei
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=skedulei
# openssl rand -base64 48
JWT_SECRET=
# Domínio (o Caddy emite o certificado HTTPS sozinho). O DNS precisa apontar para o servidor.
DOMAIN=aulas.seudominio.com.br
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@email.com

# Cadastro público e e-mail (Resend)
SIGNUP_ENABLED=true
RESEND_API_KEY=
MAIL_FROM=Skedulei <nao-responda@seudominio.com.br>
CONTACT_EMAIL=contato@seudominio.com.br
# Login social (docs/AUTENTICACAO.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Proxies na frente da API (Caddy = 1; Cloudflare + Caddy = 2)
# Lembretes por e-mail: a API roda o job a cada 5 min (1 instância). Em serverless: SCHEDULER_ENABLED=false + CRON_SECRET + pg_cron.
SCHEDULER_ENABLED=true
CRON_SECRET=
TRUST_PROXY_HOPS=1

# Criptografia do CPF em repouso: openssl rand -base64 32 — GUARDE NUM COFRE (sem ela o CPF não volta)
DATA_ENCRYPTION_KEY=
# Senha dos backups criptografados: openssl rand -base64 32 — guarde fora do servidor
BACKUP_PASSPHRASE=
# Monitoramento de erros (opcional)
SENTRY_DSN=
