# API: banco do Supabase via transaction pooler (porta 6543).
DATABASE_URL=postgres://postgres.<project-ref>:<senha>@<host-do-pooler>:6543/postgres
DB_SSL=true
DB_POOL_MAX=3
TYPEORM_MIGRATIONS_RUN=false
SCHEDULER_ENABLED=false
# Gere um segredo aleatório com pelo menos 32 caracteres.
CRON_SECRET=
NODE_ENV=production
PUBLIC_WEB_URL=https://skedulei.com.br
SIGNUP_ENABLED=true
TRUST_PROXY_HOPS=1

# API: segredos usados pela autenticação e pelos serviços.
JWT_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@email.com
RESEND_API_KEY=
MAIL_FROM=Skedulei <nao-responda@skedulei.com.br>
# Destino das mensagens do formulário de contato (/contato)
CONTACT_EMAIL=dev@skedulei.com.br
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
DATA_ENCRYPTION_KEY=
SENTRY_DSN=

# Web: URL pública do projeto da API na Vercel.
API_URL=https://<projeto-api>.vercel.app
