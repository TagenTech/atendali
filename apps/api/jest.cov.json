{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": "(src/.*\\.spec\\.ts|test/.*\\.e2e-spec\\.ts)$",
  "transform": { "^.+\\.ts$": "ts-jest" },
  "testEnvironment": "node",
  "testTimeout": 60000,
  "setupFiles": ["<rootDir>/test/env.ts"],
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/**/*.spec.ts",
    "!src/**/*.entity.ts",
    "!src/**/*.module.ts",
    "!src/**/dto/**",
    "!src/migrations/**",
    "!src/scripts/**",
    "!src/main.ts",
    "!src/serverless.ts",
    "!src/instrument.ts",
    "!src/data-source.ts"
  ],
  "coverageDirectory": "coverage",
  "coverageReporters": ["text-summary", "text", "json-summary", "json"],
  "coverageThreshold": { "global": { "statements": 90, "branches": 90, "functions": 90, "lines": 90 } }
}
