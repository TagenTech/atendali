{
  "name": "@skedulei/api",
  "version": "0.1.0",
  "private": true,
  "description": "API Skedulei — gestão de aulas (NestJS + TypeORM + Postgres)",
  "scripts": {
    "build": "nest build",
    "dev": "pnpm start:dev",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "create-user": "ts-node -r tsconfig-paths/register src/scripts/create-user.ts",
    "lint": "tsc --noEmit -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "clean": "rm -rf dist",
    "typeorm": "typeorm-ts-node-commonjs -d src/data-source.ts",
    "migration:generate": "pnpm typeorm migration:generate",
    "migration:run": "pnpm typeorm migration:run",
    "migration:run:prod": "typeorm -d dist/data-source.js migration:run",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "create-user:prod": "node dist/scripts/create-user.js",
    "test:cov": "jest --config ./jest.cov.json --runInBand --coverage"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "dependencies": {
    "@skedulei/contracts": "workspace:^",
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11.0.3",
    "@sentry/node": "^10",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16",
    "helmet": "^8",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.8",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "jest": "^29.7.0",
    "supertest": "^7",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
