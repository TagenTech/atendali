NODE_ENV=development
PORT=3200
API_PREFIX=v1

# Postgres (Postgres.app local ou `pnpm db:up`)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agendei
# true só em dev; produção usa migrations
TYPEORM_SYNC=true

# Gere com: openssl rand -base64 48
JWT_SECRET=troque-este-segredo
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# Separados por vírgula. Em dev o web usa proxy (mesma origem), então pode ficar vazio.
CORS_ORIGINS=

# Conta de desenvolvimento — usada por `pnpm api:create-user` sem argumentos (só dev)
DEV_USER_NAME="Dona Demo"
DEV_USER_EMAIL=dona@agendei.test
DEV_USER_PASSWORD=troque-esta-senha

# Web Push (gere com: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@email.com

# URL pública do web (links de e-mail: confirmação, senha, convites)
PUBLIC_WEB_URL=http://localhost:3201

# Cadastro público (false = só via pnpm api:create-user)
SIGNUP_ENABLED=true

# E-mail transacional (Resend). Sem chave, em dev os links aparecem no log e em /v1/dev/outbox.
RESEND_API_KEY=
MAIL_FROM=Agendei <nao-responda@seudominio.com.br>

# Login social — veja docs/AUTENTICACAO.md. Sem as duas variáveis, o botão some.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Quantos proxies na frente da API (nginx = 1; Cloudflare + nginx = 2). Define o IP real para o rate limit.
TRUST_PROXY_HOPS=1

# Chave de criptografia de dados sensíveis (CPF). Gere com: openssl rand -base64 32
# Guarde num cofre: sem ela o CPF cifrado não é recuperável.
DATA_ENCRYPTION_KEY=

# Monitoramento de erros (opcional). Sem dados pessoais são enviados.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
